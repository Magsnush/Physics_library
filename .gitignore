# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.vscode/
.idea/

# OS
.DS_Store

# Local env files
.env

# Wheels
*.whl

# Misc
*.log

# Explicit duplicate metadata/cache patterns
*.egg-info/
**/__pycache__/

# Profiler output. These are derived artifacts: regenerate with
#   scalene <script>          -> scalene-profile.json + scalene-profile.html
#   python -m cProfile -o profile.out <script>
# The scalene json for a long run can exceed 100 MB, which GitHub refuses to
# accept, so keep them out of the repository.
scalene-profile.*
profile.out
*.prof
